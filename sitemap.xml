<?xml version="1.0" encoding="UTF-8"?>
<!-- La app y sus páginas sueltas. No se agregan rutas de la app porque es una
     sola página — las pantallas (Home, ramo, agenda) no tienen URL propia. Si
     algún día la tienen, van acá.
     Las páginas van SIN .html: Cloudflare Pages redirige /pagina.html a
     /pagina con un 308, y un sitemap que lista redirecciones le dice a Google
     que indexe una URL que no es la final. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://gradehub.cl/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <!-- Prioridad alta: es la página que responde lo que un estudiante escribe en
       Google ("qué nota necesito para aprobar", "calcular promedio ponderado"),
       y la única puerta de entrada al sitio que no es una pantalla de login. -->
  <url>
    <loc>https://gradehub.cl/preguntas</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <!-- Responde lo que hoy se busca en Google con "calculadora de notas" y
       "escala de notas 60%": es entrada de tráfico, no una pantalla de la app. -->
  <url>
    <loc>https://gradehub.cl/calculadora</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://gradehub.cl/terminos</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://gradehub.cl/privacidad</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
