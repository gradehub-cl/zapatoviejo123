{
  "appId": "cl.gradehub.app",
  "appName": "GradeHub",
  "webDir": "ios-web",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true
    },
    "Keyboard": {
      "resize": "native"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_gradehub",
      "iconColor": "#2DD4BF"
    }
  },
  "ios": {
    "allowsLinkPreview": false,
    "loggingBehavior": "none"
  }
}
