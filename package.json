{
  "name": "gradehub",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node bin/tests.js",
    "deploy": "npx --no-install wrangler pages deploy . --project-name gradehub --branch=main --commit-dirty=true",
    "sql": "node bin/sql.js",
    "ios:preparar": "bash bin/preparar-ios.sh",
    "ios:abrir": "npx --no-install cap open ios",
    "ios:rama": "GRADEHUB_SERVIDOR=https://ios.gradehub.pages.dev bash bin/preparar-ios.sh",
    "build": "node bin/compilar-js.js",
    "prepare": "npm run build",
    "js:watch": "node bin/compilar-js.js --watch",
    "buscar": "node bin/buscar-js.js",
    "predeploy": "npm run build"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@electric-sql/pglite": "0.3.16",
    "@supabase/supabase-js": "2.112.2",
    "acorn": "8.15.0",
    "wrangler": "4.123.0"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/splash-screen": "8.0.2"
  }
}
